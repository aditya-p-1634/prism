# PRISM System Environment Configuration
PRISM_ENV=demo
DATABASE_URL=sqlite:///./prism.db
# When using Docker PostGIS:
# DATABASE_URL=postgresql+psycopg://prism:prism_dev_password@localhost:5432/prism

JWT_SECRET=dev_secret_for_sih_prototype_only_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

PRISM_TIMEZONE=Asia/Kolkata
CONFIG_VERSION=demo-1.0
SNAPSHOT_POLICY=strict
LOG_LEVEL=INFO
WORKER_CONCURRENCY=1
