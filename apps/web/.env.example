# Optional map-provider overrides. The defaults are public demo endpoints and
# must retain visible attribution in the map UI. Do not commit provider tokens.
NEXT_PUBLIC_MAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_MAP_STREETS_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_LABEL_TILES=https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}
